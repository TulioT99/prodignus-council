OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_MODEL_CONTRARIAN=replace_with_a_valid_openrouter_model_id
OPENROUTER_MODEL_PRODUCT_STRATEGY=replace_with_a_valid_openrouter_model_id
OPENROUTER_MODEL_UX_ACCESSIBILITY=replace_with_a_valid_openrouter_model_id
OPENROUTER_MODEL_DELIVERY_ENGINEERING=replace_with_a_valid_openrouter_model_id
OPENROUTER_MODEL_HUMAN_IMPACT=replace_with_a_valid_openrouter_model_id
OPENROUTER_MODEL_CHAIRMAN=replace_with_a_valid_openrouter_model_id
# Optional: per-request timeout in milliseconds (default: 90000)
# Prefer COUNCIL_ADVISOR_TIMEOUT_MS / COUNCIL_CHAIRMAN_TIMEOUT_MS when set.
OPENROUTER_REQUEST_TIMEOUT_MS=90000
# Optional: HTTP-Referer header sent to OpenRouter for app identification
OPENROUTER_HTTP_REFERER=http://localhost:3000
# Optional OpenRouter tuning
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_DEFAULT_TEMPERATURE=0.3
# OPENROUTER_MAX_TOKENS=0

# --- Council runtime configuration (WP-07 Configuration Slice) ---
# Defaults preserve current operational behavior when unset.
# COUNCIL_RETRY_MAX_ATTEMPTS=3
# COUNCIL_RETRY_BASE_DELAY_MS=0
# COUNCIL_RETRY_BACKOFF_MULTIPLIER=2
# COUNCIL_RETRY_MAX_DELAY_MS=30000
# COUNCIL_RETRY_CATEGORIES=timeout,rate_limited,transient,invalid_response
# COUNCIL_RETRY_ENABLED=true
# COUNCIL_ADVISOR_TIMEOUT_MS=90000
# COUNCIL_CHAIRMAN_TIMEOUT_MS=90000
# COUNCIL_OVERALL_TIMEOUT_MS=0
# COUNCIL_ENABLED_ADVISORS=ADV-001,ADV-002,ADV-003,ADV-004,ADV-005
# COUNCIL_ADVISOR_EXECUTION_ORDER=ADV-001,ADV-002,ADV-003,ADV-004,ADV-005
# COUNCIL_ADVISOR_MAX_CONCURRENCY=5
# COUNCIL_CHAIRMAN_ENABLED=true
# COUNCIL_MIN_SUCCESSFUL_ADVISORS=3
# COUNCIL_COMPLETE_ADVISOR_THRESHOLD=4
# COUNCIL_ALLOW_INVENTED_ADVISOR_CONTENT=false
# COUNCIL_FEATURE_STRUCTURED_LOGGING=true
# COUNCIL_FEATURE_DETAILED_TRACES=false
# COUNCIL_FEATURE_PROVIDER_DIAGNOSTICS=true
# COUNCIL_FEATURE_RETRY_METRICS=false

# Local PKOS repository path for Context Retrieval Engine (required for canonical evidence retrieval)
PKOS_REPOSITORY_PATH=C:\Projects\Hercules\hercules-knowledge
# Optional retrieval limits
# PKOS_MAX_EVIDENCE_SOURCES=5
# PKOS_MAX_EXCERPT_CHARS=2000
